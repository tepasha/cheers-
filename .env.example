# Copy to .env (git-ignored) and fill in. For EAS cloud builds create the same variables with `eas env:create`
# (visibility "Plain text" or "Sensitive", never "Secret": `eas update` cannot read Secret variables). Locally every
# value is optional (without FIREBASE_* the app starts in demo mode); preview and production builds need all of them
# (scripts/release-check.mjs --env in CI, app.config.ts on the EAS build worker).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_FIRESTORE_DATABASE_ID=
# Android only; restrict it in Google Cloud to package com.budmo.app + the signing SHA-1
GOOGLE_MAPS_API_KEY=
# Public https pages required by the stores and linked in the app (drafts: docs/store/)
PRIVACY_POLICY_URL=
TERMS_URL=
# Android push (FCM): path to google-services.json (on EAS: a file-type environment variable)
GOOGLE_SERVICES_JSON=
# Google sign-in. WEB: the Firebase project's web OAuth client (FIREBASE_OAUTH_CLIENT_ID works too). IOS: an iOS OAuth
# client for com.budmo.app. Android needs no id here: register an Android OAuth client (package + SHA-1) instead.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# iOS export compliance after the operator reviews the AES implementation: exempt or non-exempt.
EXPORT_ENCRYPTION_CLASSIFICATION=
# Release monitoring: DSN is public. Auth token is for source-map uploads only; never included in app extra.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Real operator contacts; email is required for public builds.
SUPPORT_EMAIL=
SUPPORT_URL=
# "Support the developer" button in Profile (https). Empty: the developer's monobank jar.
DONATION_URL=
