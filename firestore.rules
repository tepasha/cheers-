rules_version = '2';

// Security model
// - Shared content requires a verified email and server-issued age_21 claim.
// - Users write only their own documents; nobody can write as someone else (senderId, userId, creatorId are
//   always compared with request.auth.uid).
// - Chats are private to their `members`; messages are immutable once written.
// - Email, birth date and gamification live under users/{uid}/private and are readable by the owner only.
// - Blocking is enforced here, not just in the app: if B blocked A (document users/B/blocks/A), A cannot start a
//   chat with B, message B, take a seat at B's table, join B's meetup, or open B's profile by id.
//   Profile discovery uses server callables. Shared venues/events remain public to eligible users.
// - All other paths are denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.age_21 == true
        && !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function writeBudget(operation, resourceId) {
      let quota = getAfter(/databases/$(database)/documents/writeQuotas/$(request.auth.uid + '_' + operation)).data;
      return quota.lastAt == request.time && quota.resourceId == resourceId;
    }

    function validWriteQuota(d, key) {
      return d.keys().hasOnly(['uid', 'operation', 'count', 'windowStartedAt', 'lastAt', 'resourceId'])
        && d.uid == request.auth.uid && key == d.uid + '_' + d.operation
        && d.operation in ['message', 'hangout', 'meetup']
        && d.count is int && d.count >= 1
        && d.count <= (d.operation == 'message' ? 2000 : (d.operation == 'hangout' ? 30 : 20))
        && str(d.resourceId, 300) && d.resourceId.size() > 0
        && d.lastAt == request.time;
    }

    match /writeQuotas/{key} {
      allow get: if signedIn() && key in [request.auth.uid + '_message', request.auth.uid + '_hangout', request.auth.uid + '_meetup'];
      allow list, delete: if false;
      allow create: if verified() && validWriteQuota(request.resource.data, key)
        && request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time;
      allow update: if verified() && validWriteQuota(request.resource.data, key)
        && resource.data.uid == request.auth.uid
        && resource.data.operation == request.resource.data.operation
        && ((request.time >= resource.data.windowStartedAt + duration.value(24, 'h')
             && request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time)
          || (request.time < resource.data.windowStartedAt + duration.value(24, 'h')
             && request.resource.data.count == resource.data.count + 1
             && request.resource.data.windowStartedAt == resource.data.windowStartedAt));
    }

    // True when `owner` has blocked the caller. exists() reads the blocks collection regardless of its own read rule,
    // so the blocked person can neither see nor learn that they were blocked.
    function blockedBy(owner) {
      return exists(/databases/$(database)/documents/users/$(owner)/blocks/$(request.auth.uid));
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    // Optional field `k` of map `d`: absent, or a string of at most `max` characters
    function optStr(d, k, max) {
      return !(k in d) || str(d[k], max);
    }

    function safeSharedText(d, key) {
      return !(key in d) || !d[key].matches('(?i).*(kill yourself|i will kill you|rape you|child porn|дитяча порнографія|зґвалтую тебе|zabiję cię|vergewaltige dich).*');
    }

    function optNum(d, k, lo, hi) {
      return !(k in d) || (d[k] is number && d[k] >= lo && d[k] <= hi);
    }

    // Optional coordinate: absent, null (no location) or a number in range
    function optCoord(d, k, lim) {
      return !(k in d) || d[k] == null || (d[k] is number && d[k] >= -lim && d[k] <= lim);
    }

    // Everything in a shared collection is read by every other client, so every field has a type and a size here.
    // What a rule cannot check (the entries of a map, the items of a list) is validated where the app reads it
    // (src/logic/cloudData.ts), and a document that does not fit is skipped there instead of crashing the reader.

    // ─── Users ────────────────────────────────────────────────────────────────

    function validProfile(d, uid) {
      return d.keys().hasOnly([
          'id', 'name', 'avatar', 'tagline', 'paymentRule', 'preferredDrinks', 'currentMood',
          'locationName', 'lat', 'lng', 'age', 'updatedAt', 'bio', 'favoriteBars', 'talkTopics',
          'level', 'levelTitle', 'totalCheckIns', 'geohash', 'lastSeenAt', 'shareLocation'
        ])
        && d.id == uid
        && safeSharedText(d, 'name') && safeSharedText(d, 'tagline') && safeSharedText(d, 'bio')
        && (!('shareLocation' in d) || d.shareLocation is bool)
        && str(d.name, 60) && d.name.size() > 0
        && optStr(d, 'avatar', 500) && optStr(d, 'tagline', 140) && optStr(d, 'locationName', 120)
        && optStr(d, 'bio', 500) && optStr(d, 'levelTitle', 60) && optStr(d, 'updatedAt', 40)
        && optStr(d, 'geohash', 12) && optStr(d, 'lastSeenAt', 40)
        && optNum(d, 'lat', -90, 90) && optNum(d, 'lng', -180, 180) && optNum(d, 'age', 21, 120)
        && optNum(d, 'level', 1, 100) && optNum(d, 'totalCheckIns', 0, 1000000)
        && (!('paymentRule' in d) || d.paymentRule in ['not_specified', 'split_50_50', 'each_for_themselves', 'i_treat', 'rounds'])
        && (!('preferredDrinks' in d) || (d.preferredDrinks is list && d.preferredDrinks.size() <= 8))
        && (!('favoriteBars' in d) || (d.favoriteBars is list && d.favoriteBars.size() <= 20))
        && (!('talkTopics' in d) || (d.talkTopics is list && d.talkTopics.size() <= 20));
    }

    match /users/{uid} {
      // Other people's profiles are projected and filtered through server callables.
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && verified() && validProfile(request.resource.data, uid);
      allow delete: if isOwner(uid);

      // Owner-only data: email, birth date, gamification. Never exposed to other users.
      match /private/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && (
          (docId == 'profile'
            && request.resource.data.keys().hasOnly(['email', 'birthDate', 'termsVersion', 'termsAcceptedAt'])
            && optStr(request.resource.data, 'email', 254) && optStr(request.resource.data, 'birthDate', 10)
            // Consent is recorded only by the server. Once onboarded, DOB changes use the callable too.
            && (resource == null
                ? !request.resource.data.keys().hasAny(['termsVersion', 'termsAcceptedAt'])
                : request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                    'termsVersion' in resource.data ? ['email'] : ['email', 'birthDate'])))
          || (docId == 'gamification'
            && request.resource.data.keys().hasOnly(['xp', 'level', 'totalMeetups', 'achievements', 'lastUpdated'])
            && optNum(request.resource.data, 'xp', 0, 10000000)));
      }

      // Who this user has blocked. Only the owner can read or write it.
      match /blocks/{blockedId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && verified()
          && blockedId != uid
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'userAvatar', 'blockedAt', 'reason', 'autoBlocked'])
          && request.resource.data.userId == blockedId
          && optStr(request.resource.data, 'userName', 60) && optStr(request.resource.data, 'userAvatar', 500)
          && optStr(request.resource.data, 'blockedAt', 40) && optStr(request.resource.data, 'reason', 200);
      }

      match /favorites/{venueId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && verified()
          && request.resource.data.keys().hasOnly(['id', 'userId', 'name', 'area', 'category', 'lat', 'lng', 'comment', 'createdAt'])
          && request.resource.data.userId == uid
          && str(request.resource.data.name, 100) && optStr(request.resource.data, 'comment', 300);
      }

      match /friends/{friendId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && verified()
          && request.resource.data.keys().hasOnly([
              'id', 'userId', 'friendId', 'friendName', 'friendAvatar', 'tagline', 'locationName', 'drinkPreference', 'addedAt'
            ])
          && request.resource.data.userId == uid
          && request.resource.data.friendId == friendId;
      }
    }

    // ─── Hangouts (live "I'm at this bar" check-ins) ──────────────────────────

    function validHangout(d) {
      return d.keys().hasOnly([
          'id', 'userId', 'userName', 'userAvatar', 'barName', 'locationArea', 'drinkPreference', 'description',
          'createdAt', 'createdAtTimestamp', 'expiresAt', 'slotsAvailable', 'participantsCount', 'lat', 'lng', 'status',
          'joinedUsers', 'updatedAt'
        ])
        && d.id is string && d.userId is string
        && safeSharedText(d, 'barName') && safeSharedText(d, 'description') && safeSharedText(d, 'userName')
        && d.expiresAt is number
        && str(d.barName, 80) && d.barName.size() > 0
        && str(d.userName, 60) && optStr(d, 'userAvatar', 500)
        && optStr(d, 'locationArea', 120) && optStr(d, 'drinkPreference', 120) && optStr(d, 'description', 300)
        && optStr(d, 'createdAt', 40) && optStr(d, 'updatedAt', 40) && optNum(d, 'createdAtTimestamp', 0, 100000000000000)
        && optCoord(d, 'lat', 90) && optCoord(d, 'lng', 180)
        && (!('status' in d) || d.status in ['active', 'closed'])
        && d.slotsAvailable is number && d.slotsAvailable >= 1 && d.slotsAvailable <= 6
        && d.participantsCount is number && d.participantsCount >= 1 && d.participantsCount <= 7
        && d.joinedUsers is list && d.joinedUsers.size() <= 7;
    }

    // Anyone verified may take one free seat, exactly once, and may not touch anything else
    function isSeatJoin(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return !blockedBy(before.userId)
        && before.expiresAt > request.time.toMillis()
        && (!('status' in before) || before.status == 'active')
        && after.diff(before).affectedKeys().hasOnly(['participantsCount', 'joinedUsers', 'updatedAt'])
        && after.joinedUsers.hasAll(before.joinedUsers)
        && after.joinedUsers.size() == before.joinedUsers.size() + 1
        && uid in after.joinedUsers && !(uid in before.joinedUsers)
        && after.participantsCount == before.participantsCount + 1
        && after.participantsCount <= before.slotsAvailable + 1;
    }

    match /hangouts/{hangoutId} {
      allow read: if verified();
      allow create: if verified()
        && writeBudget('hangout', hangoutId)
        && request.resource.data.id == hangoutId
        && request.resource.data.userId == request.auth.uid
        && validHangout(request.resource.data)
        && request.resource.data.participantsCount == 1
        && request.resource.data.joinedUsers == [request.auth.uid]
        // A table lives 4 hours (+5 min of clock skew) from now: nobody can post one that never expires
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 14700000;
      allow update: if verified() && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && validHangout(request.resource.data)
          // The host only renews or closes the table; who sits there is changed by the guests themselves (isSeatJoin)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt', 'updatedAt', 'status', 'description'])
          // The host may renew the table: a new expiry is accepted only up to 4 h (+ clock skew) from now
          && (request.resource.data.expiresAt == resource.data.expiresAt
            || (request.resource.data.expiresAt > request.time.toMillis()
              && request.resource.data.expiresAt <= request.time.toMillis() + 14700000)))
        || isSeatJoin(request.auth.uid));
      allow delete: if verified() && resource.data.userId == request.auth.uid;
    }

    // ─── Scheduled group meetups ──────────────────────────────────────────────
    // `participants` is a map keyed by uid so a rule can confine each person to their own entry.

    function validMeetup(d) {
      return d.keys().hasOnly([
          'id', 'title', 'description', 'venueName', 'venueAddress', 'scheduledDate', 'scheduledTime', 'dateTimeIso',
          'drinkPreference', 'maxParticipants', 'participants', 'creatorId', 'creatorName', 'creatorAvatar', 'status',
          'lat', 'lng', 'distanceKm', 'distanceFormatted', 'createdAt', 'endsAt', 'topicTag', 'updatedAt'
        ])
        // Listed until 24 h after the start, planned at most 90 days ahead (91 days = 7862400000 ms): `endsAt` cannot park a document forever
        && d.endsAt is number && d.endsAt <= request.time.toMillis() + 7862400000
        && d.id is string && d.creatorId is string
        && safeSharedText(d, 'title') && safeSharedText(d, 'description') && safeSharedText(d, 'venueName')
        && str(d.title, 80) && d.title.size() > 0
        && optStr(d, 'description', 300) && optStr(d, 'venueName', 100) && optStr(d, 'venueAddress', 160)
        && optStr(d, 'scheduledDate', 20) && optStr(d, 'scheduledTime', 20) && optStr(d, 'dateTimeIso', 40)
        && optStr(d, 'drinkPreference', 120) && optStr(d, 'creatorName', 60) && optStr(d, 'creatorAvatar', 500)
        && optStr(d, 'distanceFormatted', 20) && optStr(d, 'createdAt', 40) && optStr(d, 'topicTag', 60)
        && optStr(d, 'updatedAt', 40)
        && optCoord(d, 'lat', 90) && optCoord(d, 'lng', 180) && optNum(d, 'distanceKm', 0, 100000)
        && d.maxParticipants is number && d.maxParticipants >= 2 && d.maxParticipants <= 30
        // Invitations reserve a place; the server enforces capacity without trusting a client counter.
        && d.participants is map && d.participants.size() <= d.maxParticipants
        && d.status in ['upcoming', 'ongoing', 'past', 'cancelled'];
    }

    // A non-creator may only add, change or remove their own entry, and only as a plain member
    function isOwnParticipation(uid) {
      let before = resource.data;
      let after = request.resource.data;
      return !blockedBy(before.creatorId)
        && (before.status in ['upcoming', 'ongoing'] || !(uid in after.participants))
        && (before.endsAt > request.time.toMillis() || !(uid in after.participants))
        && after.participants.size() <= before.maxParticipants
        && after.diff(before).affectedKeys().hasOnly(['participants', 'updatedAt'])
        && after.participants.diff(before.participants).affectedKeys().hasOnly([uid])
        && (!(uid in after.participants)
          || (after.participants[uid].userId == uid
            && after.participants[uid].role == 'member'
            && after.participants[uid].status in ['going', 'declined']));
    }

    match /group_meetups/{meetupId} {
      allow read: if verified();
      allow create: if verified()
        && writeBudget('meetup', meetupId)
        && request.resource.data.id == meetupId
        && request.resource.data.creatorId == request.auth.uid
        && validMeetup(request.resource.data);
      allow update: if verified() && (
        (resource.data.creatorId == request.auth.uid
          && request.resource.data.creatorId == request.auth.uid
          && validMeetup(request.resource.data))
        || isOwnParticipation(request.auth.uid));
      allow delete: if verified() && resource.data.creatorId == request.auth.uid;
    }

    // ─── Chats ────────────────────────────────────────────────────────────────

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function isChatMember(chatId) {
      return request.auth.uid in get(chatPath(chatId)).data.members;
    }

    function wasChatMember() {
      return request.auth.uid in resource.data.members;
    }

    // Creating a chat: DM ids are derived from the two members (so nobody can squat someone else's id),
    // group ids start with the creator's uid.
    function memberOk(d, i) {
      return d.members.size() <= i
        || (d.members[i] is string && (d.members[i] == request.auth.uid || !blockedBy(d.members[i])));
    }

    // A profile line in a chat document: the member's display name and avatar, nothing else
    function validChatProfile(p) {
      return p is map && p.keys().hasOnly(['name', 'avatar']) && optStr(p, 'name', 60) && optStr(p, 'avatar', 500);
    }

    // Types and sizes of every chat field the inbox shows (the preview, the group's description)
    function validChatFields(d) {
      return optStr(d, 'lastMessageId', 128) && optStr(d, 'lastCipherPayload', 8000) && optStr(d, 'lastMessageTime', 40) && optStr(d, 'updatedAt', 40)
        && optStr(d, 'groupName', 60) && optStr(d, 'groupTopic', 120) && optStr(d, 'groupAvatar', 500)
        && optStr(d, 'createdBy', 128)
        && safeSharedText(d, 'groupName') && safeSharedText(d, 'groupTopic')
        && (!('participants' in d) || (d.participants is list && d.participants.size() <= 9))
        && (!('profiles' in d) || (d.profiles is map && d.profiles.size() <= 2));
    }

    function noMemberBlockedCreator(d) {
      return memberOk(d, 0) && memberOk(d, 1) && memberOk(d, 2) && memberOk(d, 3) && memberOk(d, 4)
        && memberOk(d, 5) && memberOk(d, 6) && memberOk(d, 7) && memberOk(d, 8) && memberOk(d, 9);
    }

    function previewMatchesMessage(chatId, d) {
      let message = getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(d.lastMessageId)).data;
      return message.createdAt == request.time && message.senderId == request.auth.uid
        && d.lastSenderId == message.senderId && d.lastCipherPayload == message.cipherPayload
        && d.lastMessageTime == message.timestamp;
    }

    function validChatCreate(chatId, d) {
      return d.keys().hasOnly([
          'members', 'isGroup', 'createdBy', 'groupName', 'groupTopic', 'groupAvatar', 'participants', 'profiles',
          'lastCipherPayload', 'lastSenderId', 'lastMessageTime', 'updatedAt', 'lastMessageId'
        ])
        && d.members is list && d.members.size() >= 2 && d.members.size() <= 9
        // Distinct members: a duplicate would hide a newcomer from the per-index block check
        && d.members.toSet().size() == d.members.size()
        && request.auth.uid in d.members
        && noMemberBlockedCreator(d)
        && validChatFields(d)
        && (!('lastCipherPayload' in d) || d.lastCipherPayload == '' || previewMatchesMessage(chatId, d))
        // A DM carries the creator's own profile line only
        && (!('profiles' in d) || (d.profiles.keys().hasOnly([request.auth.uid]) && validChatProfile(d.profiles[request.auth.uid])))
        && d.isGroup is bool
        && d.lastSenderId == request.auth.uid
        && ((d.isGroup == false
              && d.members.size() == 2
              && chatId in ['dm_' + d.members[0] + '_' + d.members[1], 'dm_' + d.members[1] + '_' + d.members[0]])
            || (d.isGroup == true
              && d.createdBy == request.auth.uid
              && chatId.matches('grp_' + request.auth.uid + '_.*')));
    }

    // Any member may refresh the preview (and add their own profile line in a DM).
    // Only a group's creator may change membership or the group's description.
    function validChatUpdate(chatId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return wasChatMember()
        && validChatFields(after)
        && (!changed.hasAny(['lastMessageId', 'lastCipherPayload', 'lastSenderId', 'lastMessageTime']) || previewMatchesMessage(chatId, after))
        // The preview always names whoever actually wrote it: changing the text or the sender requires
        // lastSenderId to be the caller, so nobody can put words in another member's mouth
        && (!('lastSenderId' in changed) || after.lastSenderId == request.auth.uid)
        && (!('lastCipherPayload' in changed) || after.lastSenderId == request.auth.uid)
        && (
          changed.hasOnly(['lastCipherPayload', 'lastSenderId', 'lastMessageTime', 'updatedAt', 'lastMessageId'])
          || (before.isGroup == false
              && changed.hasOnly(['lastCipherPayload', 'lastSenderId', 'lastMessageTime', 'updatedAt', 'lastMessageId', 'profiles'])
              && after.profiles.diff(before.profiles).affectedKeys().hasOnly([request.auth.uid])
              && validChatProfile(after.profiles[request.auth.uid]))
          || (before.isGroup == true
              && before.createdBy == request.auth.uid
              && changed.hasOnly([
                  'members', 'participants', 'groupName', 'groupTopic', 'groupAvatar',
                  'lastCipherPayload', 'lastSenderId', 'lastMessageTime', 'updatedAt', 'lastMessageId'
                ])
              && after.members.size() <= 9
              // Existing members keep their places and nobody is listed twice, so the one newcomer is the last entry
              // and is the person checked against the creator's blocks (a reordered or duplicated list would let a
              // blocked person through under someone else's index)
              && after.members.toSet().size() == after.members.size()
              && after.members[0:before.members.size()] == before.members
              && (after.members.size() == before.members.size()
                  || (after.members.size() == before.members.size() + 1
                      && after.members[before.members.size()] is string
                      && !blockedBy(after.members[before.members.size()])))));
    }

    // In a direct chat, the other member must not have blocked the sender. (Groups are shared spaces: leaving or
    // muting is the remedy there, and creating one with someone who blocked you is refused above.)
    function notBlockedInDm(chatId) {
      let chat = getAfter(chatPath(chatId)).data;
      return chat.isGroup == true
        || !blockedBy(chat.members[0] == request.auth.uid ? chat.members[1] : chat.members[0]);
    }

    // Messages are immutable, so a proposal's status is decided by an answer message. Its id is derived from the
    // proposal (`resp_<proposalId>`), which makes "answered once" a database fact, and only the person who did
    // NOT make the proposal may answer it.
    function validProposalResponse(chatId, messageId) {
      let d = request.resource.data;
      let proposal = get(/databases/$(database)/documents/chats/$(chatId)/messages/$(d.proposalId)).data;
      return d.proposalId is string
        && messageId == 'resp_' + d.proposalId
        && d.proposalStatus in ['accepted', 'declined']
        && proposal.type == 'location_proposal'
        && proposal.senderId != request.auth.uid;
    }

    match /chats/{chatId} {
      // Listing "my chats" (where members array-contains uid) satisfies this per document
      allow read: if verified() && wasChatMember();
      allow create: if verified() && validChatCreate(chatId, request.resource.data);
      allow update: if verified() && validChatUpdate(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if verified() && isChatMember(chatId);
        // getAfter(): the message may be created in the same batch as the chat document itself
        allow create: if verified()
          && writeBudget('message', chatId + '/' + messageId)
          && request.auth.uid in getAfter(chatPath(chatId)).data.members
          && notBlockedInDm(chatId)
          && request.resource.data.keys().hasOnly([
              'id', 'chatId', 'senderId', 'senderName', 'senderAvatar', 'cipherPayload', 'type', 'proposalData', 'proposalCipher',
              'timestamp', 'isEncrypted', 'createdAt', 'audioUrl', 'audioDuration', 'proposalId', 'proposalStatus'
            ])
          && request.resource.data.id == messageId
          && request.resource.data.chatId == chatId
          && request.resource.data.senderId == request.auth.uid
          // Server time only: createdAt is the ordering key of the conversation, so neither a skewed phone clock
          // nor a forged value (a number, a far-future date) can reorder or break anyone's history
          && request.resource.data.createdAt == request.time
          && str(request.resource.data.senderName, 60)
          && (!('senderAvatar' in request.resource.data) || request.resource.data.senderAvatar == null
              || str(request.resource.data.senderAvatar, 500))
          && optStr(request.resource.data, 'timestamp', 40)
          && (!('isEncrypted' in request.resource.data) || request.resource.data.isEncrypted is bool)
          && optStr(request.resource.data, 'audioUrl', 500) && optNum(request.resource.data, 'audioDuration', 0, 3600)
          && str(request.resource.data.cipherPayload, 8000) && request.resource.data.cipherPayload.size() > 0
          && request.resource.data.type in ['text', 'cheers', 'location_proposal', 'audio', 'proposal_response']
          // Proposal details travel encrypted: plaintext venue/address/time is refused, and a proposal needs the cipher
          && (!('proposalData' in request.resource.data) || request.resource.data.proposalData == null)
          && (request.resource.data.type == 'location_proposal'
              ? (request.resource.data.proposalCipher is string && request.resource.data.proposalCipher.size() <= 4000)
              : !('proposalCipher' in request.resource.data))
          && (request.resource.data.type != 'proposal_response' || validProposalResponse(chatId, messageId))
          && (request.resource.data.type == 'proposal_response'
              || (!('proposalId' in request.resource.data) && !('proposalStatus' in request.resource.data)));
        // Messages are immutable: no edits, no deletes (a conversation cannot be rewritten after the fact)
        allow update, delete: if false;
      }
    }

    // ─── Push devices: one document per Expo push token; the Cloud Function reads them with the Admin SDK ──
    // A token belongs to the phone, not the account: when someone else signs in on the same phone they take the
    // document over (update allowed when the NEW uid is theirs), and the previous owner stops getting pushes.

    match /devices/{deviceId} {
      allow create, update: if verified()
        && request.resource.data.keys().hasOnly(['uid', 'token', 'platform', 'language', 'updatedAt', 'privatePreview', 'leaseUntil', 'bindingSequence'])
        && request.resource.data.bindingSequence is number
        && request.resource.data.bindingSequence <= request.time.toMillis() + 60000
        && (resource == null || !('bindingSequence' in resource.data)
            || request.resource.data.bindingSequence > resource.data.bindingSequence
            || (request.resource.data.bindingSequence == resource.data.bindingSequence && resource.data.uid == request.auth.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.privatePreview is bool
        && request.resource.data.leaseUntil is number
        && request.resource.data.leaseUntil > request.time.toMillis()
        && request.resource.data.leaseUntil <= request.time.toMillis() + 86700000
        && request.resource.data.token is string
        && request.resource.data.token.matches('^Expo(nent)?PushToken\\[[A-Za-z0-9_-]{10,60}\\]$')
        && deviceId == request.resource.data.token.replace('[^A-Za-z0-9_-]', '_')
        && request.resource.data.platform in ['ios', 'android']
        && request.resource.data.language in ['uk', 'en', 'pl', 'de']
        && request.resource.data.updatedAt is string;
      allow read, delete: if verified() && resource.data.uid == request.auth.uid;
    }

    // ─── Abuse reports: write-only for users, read by moderators through the Admin SDK ─────────────────

    match /reports/{reportId} {
      allow create: if verified()
        && request.resource.data.id == reportId
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly([
            'id', 'reporterId', 'reporterName', 'targetId', 'targetType', 'targetName', 'targetAvatar', 'category',
            'categoryTitle', 'comment', 'timestamp', 'createdAt', 'status', 'syncedAt', 'receivedAt', 'contextId'
          ])
        && request.resource.data.status == 'pending'
        && request.resource.data.receivedAt == request.time
        && getAfter(/databases/$(database)/documents/reportRateLimits/$(request.auth.uid)).data.lastReportId == reportId
        && getAfter(/databases/$(database)/documents/reportRateLimits/$(request.auth.uid)).data.lastAt == request.time
        && request.resource.data.targetType in ['profile', 'hangout', 'checkin', 'chat', 'group_meetup']
        && request.resource.data.category in ['harassment', 'suspicious', 'inappropriate_content', 'underage', 'toxic_behavior', 'spam', 'other']
        && str(request.resource.data.targetId, 128) && request.resource.data.targetId.size() > 0
        && str(request.resource.data.targetName, 100)
        && optStr(request.resource.data, 'reporterName', 60) && optStr(request.resource.data, 'targetAvatar', 500)
        && optStr(request.resource.data, 'categoryTitle', 120) && optStr(request.resource.data, 'timestamp', 40)
        && optStr(request.resource.data, 'contextId', 128)
        && optNum(request.resource.data, 'createdAt', 0, 100000000000000)
        && str(request.resource.data.comment, 500);
      allow get: if verified() && (resource == null || resource.data.reporterId == request.auth.uid);
      allow list, update, delete: if false;
    }

    match /reportRateLimits/{uid} {
      allow get: if verified() && isOwner(uid);
      allow list, delete: if false;
      allow create: if verified() && isOwner(uid)
        && request.resource.data.keys().hasOnly(['count', 'windowStartedAt', 'lastAt', 'lastReportId'])
        && request.resource.data.count == 1
        && request.resource.data.windowStartedAt == request.time
        && request.resource.data.lastAt == request.time
        && str(request.resource.data.lastReportId, 128);
      allow update: if verified() && isOwner(uid)
        && request.resource.data.keys().hasOnly(['count', 'windowStartedAt', 'lastAt', 'lastReportId'])
        && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(5, 's')
        && str(request.resource.data.lastReportId, 128)
        && ((request.time > resource.data.windowStartedAt + duration.value(24, 'h')
              && request.resource.data.count == 1 && request.resource.data.windowStartedAt == request.time)
            || (request.resource.data.windowStartedAt == resource.data.windowStartedAt
              && request.resource.data.count == resource.data.count + 1 && request.resource.data.count <= 20));
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
